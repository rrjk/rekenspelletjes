{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "removeComments": true,
    "module": "es2022",
    "moduleResolution": "bundler",
    "target": "es2024",
    "strict": true,
    "useDefineForClassFields": false,
    "experimentalDecorators": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "plugins": [
      {
        "name": "ts-lit-plugin",
        "strict": true,
        "globalAttributes": ["popovertarget", "popover"]
      }
    ],
    "paths": {
      "@web/rollup-plugin-import-meta-assets": [
        "./node_modules/@web/rollup-plugin-import-meta-assets/dist/index.d.ts"
      ]
    }
  },
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Recommended"
}
